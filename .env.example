# Server
APP_ENV=development
# Pakai 8082 bila 8080 sudah dipakai proses lain (mis. AgentService di Windows)
APP_PORT=8082
APP_BASE_URL=http://localhost:8082
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pkb
DB_USER=pkb_app
DB_PASSWORD=secret
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Aturan bisnis yang bisa dikonfigurasi
PPN_PERSEN_DEFAULT=11
FAKTUR_ITEMS_HALF_PAGE_MAX=10
FAKTUR_ITEMS_FULL_PAGE_MAX=30
FAKTUR_ITEMS_PER_PAGE=30
STOK_METODE_ALOKASI_DEFAULT=FEFO
FAKTUR_LOCK_AKTIF=true

# Identitas perusahaan untuk faktur
PERUSAHAAN_NAMA=PT Contoh Distribusi
PERUSAHAAN_ALAMAT=
PERUSAHAAN_TELEPON=
PERUSAHAAN_NPWP=

# Seeder super_admin (dipakai cmd/seed)
SEED_SUPER_ADMIN_EMAIL=admin@pkb.test
SEED_SUPER_ADMIN_PASSWORD=rahasia123

# Observability
LOG_LEVEL=info
LOG_FORMAT=json

# Rate limit login (gagal / menit / IP)
LOGIN_RATE_LIMIT=6

# ETL migrasi (cmd/etl) — sumber = Laravel lama (read-only), target default = DB_*
# ETL_SUMBER_HOST=127.0.0.1
# ETL_SUMBER_PORT=3306
# ETL_SUMBER_NAME=pkb_lama
# ETL_SUMBER_USER=pkb_ro
# ETL_SUMBER_PASSWORD=
# ETL_TARGET_HOST=127.0.0.1
# ETL_TARGET_PORT=3307
# ETL_TARGET_NAME=pkb
# ETL_TARGET_USER=pkb_app
# ETL_TARGET_PASSWORD=secret
# ETL_REPORT_DIR=artifacts/etl
# Gerbang tulis SF-02 — HANYA pada salinan produksi, bukan DB Laravel hidup.
# ETL_SUMBER_BOLEH_TULIS=true
